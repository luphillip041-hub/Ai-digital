# Standalone Alpaca PAPER options service.
# Keep these keys separate from trade-desk, Slam bot, Taylor dashboard, and any live account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex

ALPACA_PAPER_DEFAULT_SYMBOLS=SPY,QQQ,NVDA,TSLA,SMH,AAPL,MSFT,AMZN,GOOGL,META
ALPACA_PAPER_MAX_OPTION_SIGNALS=3
ALPACA_PAPER_MAX_ORDER_DEBIT=250
ALPACA_PAPER_OPTION_QTY=1
ALPACA_MAX_OPTION_SPREAD_PCT=25
ALPACA_MIN_OPTIONS_LEVEL=2
ALPACA_ALLOW_AFTER_HOURS_OPTIONS=false

# Dry-run unless explicitly true or --submit is passed.
ALPACA_PAPER_OPTIONS_AUTO_SUBMIT=false
