# Alpaca API credentials — https://app.alpaca.markets
# Use PAPER trading keys until you have validated the strategy.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true = paper trading (default, strongly recommended), false = live money
ALPACA_PAPER=true

# Comma-separated universe of symbols to trade
MLT_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# Risk limits
MLT_MAX_POSITION_PCT=0.20      # max fraction of equity in one symbol
MLT_MAX_GROSS_EXPOSURE=1.0     # max total long exposure as fraction of equity
MLT_ENTRY_THRESHOLD=0.55       # model P(up) required to hold a position
