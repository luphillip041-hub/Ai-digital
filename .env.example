# Copy this file to .env and fill in your Alpaca credentials.
# Get keys at https://app.alpaca.markets/ (use paper trading keys first!)

ALPACA_API_KEY=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here

# Paper trading endpoint (default). For live trading use https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data feed for equities: "iex" (free) or "sip" (paid subscription)
ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# Notifications (optional — fill in any channel(s) you want; test with
# `python -m bot.notifier`)
# ---------------------------------------------------------------------------
# Discord: server settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Telegram: create a bot with @BotFather to get the token; message the bot
# once, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP SSL. For AOL: smtp.aol.com port 465 with an app password
# (aol.com -> Account Security -> Generate app password). Gmail works the
# same way with smtp.gmail.com and a Google app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
