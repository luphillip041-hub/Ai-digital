# Flip Trading Desk — copy to .env and fill values.
# Keep this file out of Discord/screenshots once real keys are added.

# LLM provider. Good low-burn starting point: deepseek.
TRADINGAGENTS_LLM_PROVIDER=deepseek

# Low-burn defaults. If your DeepSeek account exposes only legacy aliases,
# swap these to the exact model IDs shown in your provider console.
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional providers supported by TradingAgents.
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Discord bot for 24/7 shared server access.
# Create a Discord app/bot, enable Message Content Intent, invite it with Send Messages permission.
DISCORD_BOT_TOKEN=
FLIP_DESK_DISCORD_PREFIX=!
# Optional comma-separated allowlists. Leave blank to allow all guilds/channels where the bot is invited.
FLIP_DESK_ALLOWED_GUILD_IDS=
FLIP_DESK_ALLOWED_CHANNEL_IDS=
FLIP_DESK_DEFAULT_SYMBOLS=SPY,QQQ,NVDA,TSLA,SMH,AAPL,MSFT,AMZN,GOOGL,META
FLIP_DESK_MAX_FINALISTS=5
FLIP_DESK_MONTHLY_LLM_CALL_CAP=250

# Token-burn controls.
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_TEMPERATURE=0

# Keep generated state isolated to this project.
TRADINGAGENTS_CACHE_DIR=./.cache
TRADINGAGENTS_RESULTS_DIR=./runs
TRADINGAGENTS_MEMORY_LOG_PATH=./memory/trading_memory.md
