# Flip Trading Desk — copy to .env and fill values.
# Keep this file out of Discord/screenshots once real keys are added.

# LLM provider for the native multi-agent engine: deepseek | openai |
# openrouter | openai_compatible | offline. Good low-burn start: deepseek.
FLIP_DESK_LLM_PROVIDER=deepseek

# Quick model runs analysts/debate/trader/risk; deep model runs the
# research manager and portfolio manager. If your provider console shows
# different model IDs, paste those exact IDs here.
FLIP_DESK_QUICK_MODEL=deepseek-v4-flash
FLIP_DESK_DEEP_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional alternative providers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# For provider=openai_compatible (e.g. a local server):
FLIP_DESK_LLM_BACKEND_URL=
FLIP_DESK_LLM_API_KEY=

# Discord bot for 24/7 shared server access.
# Create a Discord app/bot, enable Message Content Intent, invite it with Send Messages permission.
DISCORD_BOT_TOKEN=
FLIP_DESK_DISCORD_PREFIX=!
# Optional comma-separated allowlists. Leave blank to allow all guilds/channels where the bot is invited.
FLIP_DESK_ALLOWED_GUILD_IDS=
FLIP_DESK_ALLOWED_CHANNEL_IDS=
FLIP_DESK_DEFAULT_SYMBOLS=SPY,QQQ,NVDA,TSLA,SMH,AAPL,MSFT,AMZN,GOOGL,META
FLIP_DESK_MAX_FINALISTS=5
FLIP_DESK_MONTHLY_LLM_CALL_CAP=250

# Token-burn controls.
FLIP_DESK_MAX_OUTPUT_TOKENS=700
