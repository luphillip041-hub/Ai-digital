# Flip Trading Desk — copy to .env and fill values.
# Keep this file out of Discord/screenshots once real keys are added.

# LLM provider. Good low-burn starting point: deepseek.
TRADINGAGENTS_LLM_PROVIDER=deepseek

# Direct DeepSeek canonical IDs are usually deepseek-chat / deepseek-reasoner.
# If your provider exposes marketing IDs like deepseek-v4-flash, set them here.
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-chat
DEEPSEEK_API_KEY=

# Optional providers supported by TradingAgents.
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Token-burn controls.
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_TEMPERATURE=0

# Keep generated state isolated to this project.
TRADINGAGENTS_CACHE_DIR=./.cache
TRADINGAGENTS_RESULTS_DIR=./runs
TRADINGAGENTS_MEMORY_LOG_PATH=./memory/trading_memory.md
